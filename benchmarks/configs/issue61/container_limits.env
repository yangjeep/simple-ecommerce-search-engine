# Issue #61 (Infra E1) — frozen resource limits for every measured engine.
#
# Single source of truth referenced by ISSUE61_PROTOCOL.md §8. Every
# provisioning and benchmark script sources THIS file rather than hard-coding
# flags, so an engine cannot silently be measured under different limits than
# its comparator.
#
# Rationale for each value is recorded here because "why 3 CPUs" is exactly the
# kind of undocumented local state that makes a benchmark unreproducible.

# ---------------------------------------------------------------------------
# CPU
# ---------------------------------------------------------------------------
# The host has 4 vCPU (QEMU Virtual CPU version 2.5+). The engine under test
# gets cores 0-2; the benchmark driver is pinned to core 3 (see I61_DRIVER_CPU)
# so the driver's own HTTP/serialization work never competes with the engine it
# is measuring. Without this split, a faster engine would be penalised by
# driver contention on a 4-core box.
I61_CPUS=3
I61_CPUSET=0-2
I61_DRIVER_CPU=3

# ---------------------------------------------------------------------------
# Memory
# ---------------------------------------------------------------------------
# I61_MEMORY_SWAP is pinned EQUAL to I61_MEMORY. This is not cosmetic: the host
# has 4 GiB of swap enabled, and Docker's default --memory-swap is twice
# --memory. A memory-pressured engine would therefore be silently rescued by
# swap, and every serving_rss_bytes number -- the metric the campaign's >=25%
# RSS materiality bar depends on -- would be meaningless.
I61_MEMORY=6g
I61_MEMORY_SWAP=6g

# ---------------------------------------------------------------------------
# Engine images (digest-pinned, never floating tags)
# ---------------------------------------------------------------------------
# Solr stays at 9.10.1 to match the version prior comparator checkpoints used
# (ISSUE55_COMPARATOR_CENTRALIZATION_DECISION.md,
# ISSUE35_SOLR_HARNESS_HARDENING_DECISION.md), so E1 changes the measurement
# method without also changing the comparator identity.
I61_SOLR_IMAGE=solr:9.10.1
I61_SOLR_DIGEST=sha256:1f055b0260d3efb177b12d6a46e9ef510fb4d2616473a91f8f4d099384aa176a
I61_SOLR_CONTAINER=i61-solr
I61_SOLR_PORT=8983

# Elasticsearch is SECONDARY and time-boxed per protocol §2.4. If its smoke
# test does not pass inside the box, the recorded verdict is
# DEFERRED-TO-PRE-E2 and E1's gate is computed on native + Solr only.
I61_ES_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:8.15.0
I61_ES_CONTAINER=i61-es
I61_ES_PORT=9200

# ---------------------------------------------------------------------------
# JVM heap
# ---------------------------------------------------------------------------
# 2 GiB of the 6 GiB container budget. Deliberately NOT the whole container:
# Lucene serves its index through MMapDirectory, so the remaining ~4 GiB is
# left to the OS page cache backing those mapped files. Handing all 6 GiB to
# the Java heap would starve the page cache and cripple the baseline -- the
# exact straw-man failure mode Issue #61 forbids.
#
# 2 GiB is generous for a 42,994-document corpus, so the baseline is not
# heap-constrained at this corpus size.
I61_SOLR_HEAP=2g
I61_ES_HEAP=2g

# ---------------------------------------------------------------------------
# Measurement protocol constants (protocol §9, §11)
# ---------------------------------------------------------------------------
I61_REPETITIONS=10
I61_WARMUP_PASSES=3
I61_STEAL_EXCLUSION_PCT=1.0
I61_MAX_EXCLUSIONS_PER_CELL=2
I61_BOOTSTRAP_RESAMPLES=10000
I61_BOOTSTRAP_SEED=61

# ---------------------------------------------------------------------------
# Corpus expectations (stop conditions, protocol §13)
# ---------------------------------------------------------------------------
# A doc count that differs from these means the corpus is not the corpus prior
# evidence was measured on; the run aborts rather than reporting numbers.
I61_WANDS_EXPECTED_DOCS=42994
I61_WANDS_EXPECTED_QUERIES=480
I61_ESCI_ELECTRONICS_EXPECTED_DOCS=2075
I61_ESCI_ELECTRONICS_EXPECTED_QUERIES=600
