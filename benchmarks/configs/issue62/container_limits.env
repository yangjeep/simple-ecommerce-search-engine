# Issue #62 (Infra E2) — frozen-for-this-experiment resource limits.
#
# New file, independent of #61's benchmarks/configs/issue61/container_limits.env
# (which stays untouched — that file's WANDS/ESCI-native-corpus limits are not
# sized for E2's 100k-5M-row scaled catalogs). Every E2 provisioning script
# sources THIS file.
#
# Host: 4 vCPU, ~26 GiB available RAM confirmed live at preregistration time
# (see the #62 preregistration comment). Engines run sequentially (one
# container at a time, matching #61's resource-isolation philosophy), so each
# engine gets a generous budget without host oversubscription risk.

# ---------------------------------------------------------------------------
# CPU
# ---------------------------------------------------------------------------
I62_CPUS=3
I62_CPUSET=0-2
I62_DRIVER_CPU=3

# ---------------------------------------------------------------------------
# Memory
# ---------------------------------------------------------------------------
# 16 GiB budget per engine (vs #61's 6 GiB): E2's largest tier is ~117x #61's
# corpus size, so a proportionally larger budget is needed for a fair,
# not-artificially-memory-starved measurement. Swap pinned equal to memory
# (matches #61's rationale: an engine rescued by swap makes every RSS number
# meaningless for the >=25% materiality bar).
I62_MEMORY=6g
I62_MEMORY_SWAP=6g

# JVM heap: half the container budget, mirroring #61's rationale (Lucene/JVM
# engines serve their index through mmap; handing the whole container to heap
# would starve the page cache and cripple the baseline).
I62_JVM_HEAP=3g

# REVISED mid-campaign 2026-09-14: originally 16g/8g heap, sized for the
# ~26-30 GiB host confirmed available at preregistration time. Host
# MemTotal was independently observed to drop to ~13-15 GiB (no reboot —
# a shared-host reallocation, high concurrent load average confirmed at the
# same time) partway through the 100k tier. Reduced to 6g/3g (matching #61's
# own precedent for a resource-constrained shared host) for all cells run
# after this point, disclosed in the #62 decision doc. Already-completed
# 100k-tier cells were measured with real observed peak usage safely under
# even this reduced ceiling (native ~1.2GB, Solr ~9.4GB peak build, well
# under the then-available headroom) — not retroactively invalidated, but
# the nominal *limit* they ran under (16g) differs from cells measured
# after this line changed; the decision doc records exactly which cells are
# which.

# ---------------------------------------------------------------------------
# Engine images (digest-pinned where a specific version was already verified
# to pull in this session; see the #62 preregistration comment for the live
# pull verification)
# ---------------------------------------------------------------------------
I62_SOLR_IMAGE=solr:9.10.1
I62_SOLR_CONTAINER=i62-solr
I62_SOLR_PORT=8984

I62_ES_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:8.15.0
I62_ES_CONTAINER=i62-elasticsearch
I62_ES_PORT=9201

I62_OPENSEARCH_IMAGE=opensearchproject/opensearch:2.19.0
I62_OPENSEARCH_CONTAINER=i62-opensearch
I62_OPENSEARCH_PORT=9202

I62_TYPESENSE_IMAGE=typesense/typesense:27.1
I62_TYPESENSE_CONTAINER=i62-typesense
I62_TYPESENSE_PORT=8108
I62_TYPESENSE_API_KEY=i62-benchmark-key

I62_MEILISEARCH_IMAGE=getmeili/meilisearch:v1.11
I62_MEILISEARCH_CONTAINER=i62-meilisearch
I62_MEILISEARCH_PORT=7700

I62_VESPA_IMAGE=vespaengine/vespa:latest
I62_VESPA_CONTAINER=i62-vespa
I62_VESPA_CONFIG_PORT=19071
I62_VESPA_QUERY_PORT=8081

I62_HAVENASK_IMAGE=registry.cn-hangzhou.aliyuncs.com/havenask/ha3_runtime:latest
I62_HAVENASK_CONTAINER=i62-havenask

I62_NATIVE_CONTAINER=i62-native
I62_NATIVE_PORT=9901

# ---------------------------------------------------------------------------
# Catalog tiers (scripts/datasets/replicate_wands_scale.py output)
# ---------------------------------------------------------------------------
# tier -> (multiplier, expected row count)
I62_TIER_100K_MULTIPLIER=3
I62_TIER_100K_DOCS=128982
I62_TIER_500K_MULTIPLIER=12
I62_TIER_500K_DOCS=515928
I62_TIER_1M_MULTIPLIER=24
I62_TIER_1M_DOCS=1031856
I62_TIER_3M_MULTIPLIER=70
I62_TIER_3M_DOCS=3009580
I62_TIER_5M_MULTIPLIER=117
I62_TIER_5M_DOCS=5030298

I62_BUILD_TIMEOUT_SECONDS=3600
I62_READINESS_TIMEOUT_SECONDS=120
