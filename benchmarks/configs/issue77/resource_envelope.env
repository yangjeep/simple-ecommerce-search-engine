# Issue #77 (Infra E3) — frozen-for-this-experiment resource envelope.
#
# Explicit and self-contained, not "reuse #62's config by reference" — #62's
# adversarial review found an implicit-config-inheritance bug (native's
# container silently exempt from a mid-campaign memory reduction every
# competitor was held to). Every E3 provisioning script and the Rust
# orchestrator (`crates/issue77-eval`) source THIS file for every engine
# including native, via the same code path, with no engine-specific
# hardcoded exemption anywhere.
#
# Host: same shared host as #61/#62. Value chosen (6g/6g) matches #62's
# already-proven-working final configuration at the 500k tier for every one
# of the 7 engines E3 also targets (including native) — not a fresh guess.

# ---------------------------------------------------------------------------
# CPU
# ---------------------------------------------------------------------------
I77_CPUS=3
I77_CPUSET=0-2
I77_DRIVER_CPU=3

# ---------------------------------------------------------------------------
# Memory — identical value and identical code path for every engine
# including native. Swap pinned equal to memory (an engine rescued by swap
# makes every RSS/latency number meaningless for the >=25% materiality bar).
# ---------------------------------------------------------------------------
I77_MEMORY=6g
I77_MEMORY_SWAP=6g

# JVM heap: half the container budget, matching #61/#62's precedent
# (Lucene/JVM engines serve their index through mmap; handing the whole
# container to heap would starve the page cache and cripple the baseline).
# Preregistered before measurement; recorded per-cell in raw result
# provenance (read live from this file at invocation time, never a
# hardcoded constant — #62's adversarial review found exactly that bug).
I77_JVM_HEAP=3g

# ---------------------------------------------------------------------------
# Engine images (same versions #62 already verified pull/run on this host)
# ---------------------------------------------------------------------------
I77_SOLR_IMAGE=solr:9.10.1
I77_SOLR_CONTAINER=i77-solr
I77_SOLR_PORT=8985

I77_ES_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:8.15.0
I77_ES_CONTAINER=i77-elasticsearch
I77_ES_PORT=9213

I77_OPENSEARCH_IMAGE=opensearchproject/opensearch:2.19.0
I77_OPENSEARCH_CONTAINER=i77-opensearch
I77_OPENSEARCH_PORT=9204

I77_TYPESENSE_IMAGE=typesense/typesense:27.1
I77_TYPESENSE_CONTAINER=i77-typesense
I77_TYPESENSE_PORT=8109
I77_TYPESENSE_API_KEY=i77-benchmark-key

I77_MEILISEARCH_IMAGE=getmeili/meilisearch:v1.11
I77_MEILISEARCH_CONTAINER=i77-meilisearch
I77_MEILISEARCH_PORT=7701

I77_VESPA_IMAGE=vespaengine/vespa:latest
I77_VESPA_CONTAINER=i77-vespa
I77_VESPA_CONFIG_PORT=19072
I77_VESPA_QUERY_PORT=8082

I77_HAVENASK_IMAGE=registry.cn-hangzhou.aliyuncs.com/havenask/ha3_runtime:latest
I77_HAVENASK_CONTAINER=i77-havenask

I77_NATIVE_CONTAINER=i77-native
I77_NATIVE_PORT=9902

# ---------------------------------------------------------------------------
# Dataset A: reuse #62's already-generated WANDS-scale catalogs. Primary
# tier is 500k (the largest tier every one of the 7 engines actually
# completed in #62); 100k retained for calibration/debugging only. 1M is
# secondary-stress-only and does not gate the primary 500k question.
# ---------------------------------------------------------------------------
I77_TIER_100K_MULTIPLIER=3
I77_TIER_100K_DOCS=128982
I77_TIER_500K_MULTIPLIER=12
I77_TIER_500K_DOCS=515928
I77_TIER_1M_MULTIPLIER=24
I77_TIER_1M_DOCS=1031856
I77_CATALOG_100K_PATH=dataset_cache/wands_scale/catalog_3x.jsonl
I77_CATALOG_500K_PATH=dataset_cache/wands_scale/catalog_12x.jsonl
I77_CATALOG_1M_PATH=dataset_cache/wands_scale/catalog_24x.jsonl

# ---------------------------------------------------------------------------
# Timeouts / warmup / measurement window / repetition
# ---------------------------------------------------------------------------
I77_BUILD_TIMEOUT_SECONDS=3600
I77_READINESS_TIMEOUT_SECONDS=3600
I77_WARMUP_QUERY_COUNT=20
I77_MEASURED_QUERY_COUNT=200
I77_RUN_COUNT=3

# ---------------------------------------------------------------------------
# Base-PLP candidate-depth buckets (Workload A). Chosen by percentile rank
# against the REAL unscaled WANDS category-size distribution (42,994 docs,
# min=1 p25=1 median=3 p75=13 max=1103) -- category_leaf strings/counts
# scale exactly linearly under #62's row-replication method (verified:
# `scripts/datasets/replicate_wands_scale.py` copies rows byte-identically,
# only suffixing `id`, so per-category counts scale by the exact tier
# multiplier). Not hand-picked for a favorable outcome; method and inputs
# disclosed here, reproducible from dataset_cache/wands/catalog.jsonl.
I77_CATEGORY_NARROW="Furniture / Living Room Furniture / Chairs & Seating / Chaise Lounge Chairs / Linen Chaise Lounge Chairs"
I77_CATEGORY_NARROW_UNSCALED_DOCS=3
I77_CATEGORY_MEDIUM="Outdoor / Outdoor Shades / Pergolas"
I77_CATEGORY_MEDIUM_UNSCALED_DOCS=13
I77_CATEGORY_BROAD="Furniture / Living Room Furniture / Chairs & Seating / Accent Chairs"
I77_CATEGORY_BROAD_UNSCALED_DOCS=1103

# ---------------------------------------------------------------------------
# Filter-depth / faceting / numeric-range workload values. NOT category-
# scoped (unlike Workload A above) -- discovered live via #77's first Solr
# smoke test that I77_CATEGORY_BROAD ("Accent Chairs") has 0% real coverage
# for color/primarymaterial/material/shape (only ~36% style coverage;
# verified via `color:* AND category_leaf:"Accent Chairs"` returning 0 of
# 3309 docs on the live index) -- every filter/facet cell scoped to it would
# have been silently degenerate (trivially empty) regardless of engine.
# These values are instead verified directly against the real unscaled
# corpus (`dataset_cache/wands/catalog.jsonl`) to have genuine, non-zero,
# progressively-narrowing matches; also discovered live: `material` and
# `primarymaterial` are almost mutually exclusive in real WANDS data (only
# 15/42,994 docs have both populated), so the depth ladder below uses only
# one of the two, not both.
I77_FILTER_DEPTH1_COLOR=white
I77_FILTER_DEPTH1_UNSCALED_DOCS=1438
I77_FILTER_DEPTH3_STYLE="modern & contemporary"
I77_FILTER_DEPTH3_PRIMARYMATERIAL=metal
I77_FILTER_DEPTH3_UNSCALED_DOCS=3
I77_FILTER_DEPTH5_SHAPE=square
I77_FILTER_DEPTH5_RATING_GTE=4
I77_FILTER_DEPTH5_UNSCALED_DOCS=1
I77_FACET_COLOR_PROBE=black
I77_FACET_STYLE_PROBE="modern & contemporary"
